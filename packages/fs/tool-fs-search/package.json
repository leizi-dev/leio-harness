{
  "name": "@leio-ai/leio-tool-fs-search",
  "description": "Model-facing filesystem discovery tools (glob, grep) backed by the packaged ripgrep binary (@vscode/ripgrep)",
  "version": "0.1.0-rc.7",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leizi-dev/leio-harness.git",
    "directory": "packages/fs/tool-fs-search"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@vscode/ripgrep": "^1.18.0",
    "@deepseek-ai/schemastery": "workspace:^"
  },
  "peerDependencies": {
    "@leio-ai/leio-invariants": "workspace:^",
    "@leio-ai/leio-llm": "workspace:^",
    "@leio-ai/leio-output-retention": "workspace:^",
    "@leio-ai/leio-session": "workspace:^",
    "@leio-ai/leio-spill": "workspace:^",
    "@leio-ai/leio-subprocess": "workspace:^",
    "@leio-ai/leio-system-prompt": "workspace:^",
    "@leio-ai/leio-timeout": "workspace:^",
    "@leio-ai/leio-tools": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^"
  },
  "devDependencies": {
    "@leio-ai/leio-agent": "workspace:^",
    "@leio-ai/leio-subprocess": "workspace:^",
    "@leio-ai/leio-subprocess-local": "workspace:^",
    "@leio-ai/leio-invariants": "workspace:^",
    "@leio-ai/leio-llm": "workspace:^",
    "@leio-ai/leio-output-retention": "workspace:^",
    "@leio-ai/leio-session": "workspace:^",
    "@leio-ai/leio-spill": "workspace:^",
    "@leio-ai/leio-system-prompt": "workspace:^",
    "@leio-ai/leio-timeout": "workspace:^",
    "@leio-ai/leio-tools": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^"
  }
}
