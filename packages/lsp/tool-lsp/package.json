{
  "name": "@leio-ai/leio-tool-lsp",
  "description": "Model-facing lsp tool over the Leio Harness LSP capability seam (ctx.lsp) — one read-only tool with goToDefinition/findReferences/goToImplementation/hover operations, one-based UTF-16 cursor coordinates, bounded location rendering, and hover normalization",
  "version": "0.1.0-rc.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leizi-dev/leio-harness.git",
    "directory": "packages/lsp/tool-lsp"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@leio-ai/leio-invariants": "workspace:^",
    "@leio-ai/leio-llm": "workspace:^",
    "@leio-ai/leio-lsp": "workspace:^",
    "@leio-ai/leio-system-prompt": "workspace:^",
    "@leio-ai/leio-timeout": "workspace:^",
    "@leio-ai/leio-tools": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@leio-ai/leio-agent": "workspace:^",
    "@leio-ai/leio-fs-local": "workspace:^",
    "@leio-ai/leio-invariants": "workspace:^",
    "@leio-ai/leio-llm": "workspace:^",
    "@leio-ai/leio-lsp": "workspace:^",
    "@leio-ai/leio-lsp-stdio": "workspace:^",
    "@leio-ai/leio-session": "workspace:^",
    "@leio-ai/leio-subprocess-local": "workspace:^",
    "@leio-ai/leio-system-prompt": "workspace:^",
    "@leio-ai/leio-timeout": "workspace:^",
    "@leio-ai/leio-tool-call-timeout-policy": "workspace:^",
    "@leio-ai/leio-tools": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^"
  }
}
