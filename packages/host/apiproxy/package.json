{
  "name": "@leio-ai/leio-host-apiproxy",
  "description": "API gateway: the ApiProxy contract (api/), the fetch carrier pair (fetch/), and the host-side gateway plugin providing ctx.apiProxy",
  "version": "0.1.0-rc.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leizi-dev/leio-harness.git",
    "directory": "packages/host/apiproxy"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./api": {
      "types": "./lib/types/api/index.d.ts",
      "default": "./lib/types/api/index.js"
    },
    "./api/*": {
      "types": "./lib/types/api/*.d.ts",
      "default": "./lib/types/api/*.js"
    },
    "./client": {
      "types": "./lib/types/fetch/client.d.ts",
      "default": "./lib/types/fetch/client.js"
    }
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@leio-ai/leio-attachment": "workspace:^",
    "@leio-ai/leio-agent": "workspace:^",
    "@leio-ai/leio-agent-default-model": "workspace:^",
    "@leio-ai/leio-api-remotes": "workspace:^",
    "@leio-ai/leio-brand": "workspace:^",
    "@leio-ai/leio-commands": "workspace:^",
    "@leio-ai/leio-credentials": "workspace:^",
    "@leio-ai/leio-goal": "workspace:^",
    "@leio-ai/leio-host-directory-picker": "workspace:^",
    "@leio-ai/leio-llm": "workspace:^",
    "@leio-ai/leio-native-command": "workspace:^",
    "@leio-ai/leio-session": "workspace:^",
    "@leio-ai/leio-session-persistence": "workspace:^",
    "@leio-ai/leio-session-projection": "workspace:^",
    "@leio-ai/leio-session-projection-cache": "workspace:^",
    "@leio-ai/leio-session-query": "workspace:^",
    "@leio-ai/leio-session-title": "workspace:^",
    "@leio-ai/leio-settings": "workspace:^",
    "@leio-ai/leio-skill": "workspace:^",
    "@leio-ai/leio-subagent": "workspace:^",
    "@leio-ai/leio-jobs": "workspace:^",
    "@leio-ai/leio-tools": "workspace:^",
    "@leio-ai/leio-user-approval": "workspace:^",
    "@leio-ai/leio-user-questions": "workspace:^",
    "@leio-ai/leio-workspace": "workspace:^",
    "@deepseek-ai/schemastery": "workspace:^",
    "fflate": "^0.8.2",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@leio-ai/leio-agent-presets": "workspace:^",
    "@leio-ai/leio-cordis-host-runner": "workspace:^",
    "@leio-ai/leio-invariants": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@leio-ai/leio-agent-presets": "workspace:^",
    "@leio-ai/leio-cordis-host-runner": "workspace:^",
    "@leio-ai/leio-invariants": "workspace:^",
    "@leio-ai/leio-storage": "workspace:^",
    "@leio-ai/leio-storage-domain": "workspace:^",
    "@leio-ai/leio-typert-protocol": "workspace:^",
    "@leio-ai/leio-typert-registry": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^"
  }
}
